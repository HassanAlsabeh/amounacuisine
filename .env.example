# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables for production.

# Super admin, created on first sign-in. After that, change the password from
# the admin panel (Account); these two are no longer read.
ADMIN_USERNAME=amounacuisine
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin session cookie. Use a long random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# Postgres connection string. On Vercel this is filled in when you connect a
# Neon database (Storage → Neon). Leave empty locally to use the embedded database in .data/.
DATABASE_URL=

# Vercel Blob token for photo uploads. Filled in when you connect a Blob store
# (Storage → Blob). Leave empty locally to save uploads in public/uploads.
BLOB_READ_WRITE_TOKEN=
